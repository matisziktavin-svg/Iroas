# setup.bat fills this in for you — you shouldn't need to edit it by hand.

# Claude subscription token from `claude setup-token` (lasts ~1 year).
# Subscription only: never put an ANTHROPIC_API_KEY here.
CLAUDE_CODE_OAUTH_TOKEN=

# From @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# From https://hevy.com/settings?developer (Hevy Pro).
HEVY_API_KEY=

# Send "/start <this code>" to your bot once to pair it with your Telegram account.
PAIRING_CODE=

# Optional: force a model (e.g. claude-sonnet-5). Blank = your plan's default.
IROAS_MODEL=
